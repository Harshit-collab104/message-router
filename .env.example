# Private developer/admin APIs fail closed until this is set.
GATEWAY_API_TOKEN=
# Optional comma-separated browser origins; same-origin console needs none.
GATEWAY_CORS_ORIGINS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_AUTO_REPLY=false
TWILIO_AUTH_TOKEN=
# Exact externally configured URL, including query string, when behind a proxy.
TWILIO_WEBHOOK_URL=

# CSV metadata, incoming messages, media and predictions. Relative paths use the repo directory.
MESSAGE_ROUTER_DATA_DIR=dataset
# Skip all provider calls, vector reads/writes and outbound delivery when true.
MESSAGE_ROUTER_OFFLINE=false
# Optional storage overrides; blank keeps the existing default locations.
MESSAGE_ROUTER_CHROMA_DIR=
MESSAGE_ROUTER_GATEWAY_DB=
